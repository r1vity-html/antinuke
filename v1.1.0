@system_group.command(name="toggle-anti-hijack", description="開啟或關閉反被盜帳功能 (管理員)")
@app_commands.describe(mode="輸入 on 或 off")
async def toggle_anti_hijack(interaction: discord.Interaction, mode: str):
    gid = interaction.guild.id
    mode_lower = mode.lower()
    if mode_lower not in ("on", "off", "true", "false", "enable", "disable"):
        await interaction.response.send_message("請輸入 `on` 或 `off`。", ephemeral=True)
        return
    enabled = mode_lower in ("on", "true", "enable")
    anti_hijack_settings[gid]["enabled"] = enabled
    await interaction.response.send_message(f"反被盜帳功能已{'啟用' if enabled else '關閉'}。", ephemeral=True)

@system_group.command(name="add-black", description="將使用者或機器人加入全域黑名單 (開發者)")
@app_commands.describe(target_id="欲黑名單的 真人使用者 或 機器人 ID", reason="原因")
async def add_black(interaction: discord.Interaction, target_id: str, reason: str = ""):
    global bot_blacklist
    
    # 權限檢查：只有開發者能用
    if interaction.user.id != DEVELOPER_ID:
        await interaction.response.send_message("❌ 只有開發者可以使用此指令", ephemeral=True)
        return
        
    # 檢查輸入的是否為純數字 ID
    if not target_id.isdigit():
        await interaction.response.send_message("❌ 請輸入正確的 Discord ID (必須為純數字)！", ephemeral=True)
        return

    # 如果已經在記憶體快取中了，提示已存在
    if target_id in bot_blacklist:
        await interaction.response.send_message("⚠️ 該目標（人/機）已經在黑名單中了。", ephemeral=True)
        return

    # 先回應 Discord，避免 API 超時 (因為 fetch_user 稍微需要時間)
    await interaction.response.defer()

    # 嘗試抓取這個 ID 的真實名稱 (不論是人還是機器人)
    target_name = f"未知用戶 ({target_id})"
    try:
        user = bot.get_user(int(target_id))
        if not user:
            user = await bot.fetch_user(int(target_id))
        if user:
            target_name = f"{user.name}#{user.discriminator}" if user.discriminator != "0" else user.name
    except Exception:
        # 抓不到名字也沒關係，直接用 ID 代替
        target_name = f"ID: {target_id}"

    # 1. 更新記憶體快取（保持你原本的資料結構，以便 save_blacklist 運作）
    bot_blacklist[target_id] = {
        "name": target_name, 
        "reason": reason, 
        "timestamp": time.time(), 
        "guilds_detected": []
    }
    
    # 2. 呼叫你原本的儲存函式
    # (只要 save_blacklist 內部是將字典的 key 寫入 MySQL 的 bot_id，就能完美相容！)
    save_blacklist(bot_blacklist)

    # 3. 建立精美的回應 Embed
    embed = discord.Embed(title="🚨 已加入全域黑名單 (人機通防)", color=discord.Color.red())
    embed.description = (
        f"**目標名稱/ID**: `{target_name}`\n"
        f"**目標 ID**: `{target_id}`\n\n"
        "該目標已被列入全域核心黑名單，系統稍後將在所有伺服器中同步進行巡邏與封鎖。\n"
        "如需在特定伺服器放行，請伺服器擁有者使用 `/add-server-anti-kick` 將其加入防踢白名單。"
    )
    embed.add_field(name="原因", value=reason if reason else "未提供原因", inline=False)
    embed.set_footer(text=f"防炸兔兔 {VERSION}")
    
    # 發送通知
    await interaction.followup.send(embed=embed)
    
    # 4. 觸發我們上一部改好的「不分人機」全域巡邏掃描
    await scan_blacklist_all_guilds()

@bot.tree.command(name="coin", description="查詢自己或他人的金幣餘額")
