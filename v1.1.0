@bot.tree.command(name="task", description="🛡️ 兔兔每日日常任務！達成小互動賺取高額金幣")
async def task(interaction: discord.Interaction):
    user_id = interaction.user.id
    current_time = time.time()
    
    # ─── 💾 從 MySQL 讀取狀態 ───
    status = get_user_status(user_id)
    
    # 💡 核心修正：如果拿出來的是 Tuple，我們直接依序拆解成變數！
    # 如果拿出來本來就是 Dict，也可以防呆處理：
    if isinstance(status, dict):
        t_id = status["task_id"]
        t_progress = status["task_progress"]
        t_completed = status["task_completed"]
        t_time = status["task_time"]
    else:
        # 按照 SELECT 欄位的順序：task_id, task_progress, task_completed, task_time, work_cooldown
        t_id, t_progress, t_completed, t_time, _ = status

    # 1. 檢查是否需要刷新任務（過了一天，86400秒）
    if t_id is not None and (current_time - t_time >= 86400):
        update_user_status(
            user_id, 
            task_id=None, 
            task_progress=0, 
            task_completed=False, 
            task_time=0
        )
        # 重新讀取並拆解
        status = get_user_status(user_id)
        if isinstance(status, dict):
            t_id, t_progress, t_completed, t_time = status["task_id"], status["task_progress"], status["task_completed"], status["task_time"]
        else:
            t_id, t_progress, t_completed, t_time, _ = status
        
    # 2. 如果沒有任務，就在這裡鎖定並寫入
    if t_id is None:
        chosen_task_id = random.choice(list(TASK_POOL.keys()))
        update_user_status(
            user_id,
            task_id=chosen_task_id,
            task_progress=0,
            task_completed=False,
            task_time=current_time
        )
        print(f"[Task System] 已為玩家 {interaction.user.name} 鎖定任務 ID: {chosen_task_id}")
        t_id = chosen_task_id
        t_progress = 0
        t_completed = False

    # 3. 渲染面板
    t_info = TASK_POOL[t_id]
    embed = discord.Embed(title="🛡️ 兔兔每日日常任務 🛡️", color=discord.Color.blue())
    
    if t_completed:
        embed.description = "🎉 **今日任務已全部完成！明天再來吧！**"
        embed.add_field(name="今日事今日畢", value="🔓 獎勵已存入你的錢包。")
    else:
        embed.description = f"**任務內容：**\n> {t_info['desc']}"
        embed.add_field(name="📊 當前進度", value=f"`{t_progress} / {t_info['needed']}`", inline=True)
        embed.add_field(name="🪙 任務報酬", value=f"**{t_info['reward']}** 金幣", inline=True)
        embed.set_footer(text="提示：完成後滿足進度，獎勵會自動發放或再次輸入 /task 查看喔！")
        
    await interaction.response.send_message(embed=embed)

@server_group.command(name="rp_config", description="⚙️ [管理員專用] 設定紅包功能的啟用狀態與是否開起洗頻廣播")
@app_commands.describe(
    status="True 為開啟紅包，False 為暫停紅包", 
    broadcast="True 為開啟聊天室中獎喜報，False 為關閉廣播防止洗版"
)
async def config_redpacket(interaction: discord.Interaction, status: bool, broadcast: bool):
    # 檢查是否為管理員
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ 你沒有權限操控兔兔銀行！", ephemeral=True)
        return
        
    # 1. 寫入資料庫，永久保存設定
    update_setting('redpacket_enabled', status)
    update_setting('redpacket_broadcast_enabled', broadcast)
    
    # 2. 顯示結果
    state_msg = "🟢 **已開啟**" if status else "🔴 **已暫停**"
    bc_msg = "🔊 **會發送中獎喜報**" if broadcast else "🔕 **低調默默領取（防洗版）**"
    
    embed = discord.Embed(
        title="⚙️ 紅包系統設定更新 (已儲存至資料庫)",
        description=f"管理員 {interaction.user.mention} 已調整系統設定：",
        color=discord.Color.blue()
    )
    embed.add_field(name="📌 紅包功能狀態", value=state_msg, inline=True)
    embed.add_field(name="💬 聊天室廣播", value=bc_msg, inline=True)
    
    await interaction.response.send_message(embed=embed)
    print(f"[系統設定] 資料庫更新 - 紅包開關: {status} | 喜報廣播: {broadcast}")

@system_group.command(name="announce-all", description="向所有伺服器發送全服公告 (開發者)")
@app_commands.describe(message="公告內容")
async def announce_all(interaction: discord.Interaction, message: str):
    if interaction.user.id != DEVELOPER_ID:
        await interaction.response.send_message("只有開發者可以使用此指令", ephemeral=True)
        return
    content = message.strip()
    if not content:
        await interaction.response.send_message("公告內容不得為空。", ephemeral=True)
        return
    await interaction.response.defer(ephemeral=True)
    sender_display = f"{interaction.user} (ID: {interaction.user.id})"
    stats = {"log": 0, "dm": 0, "scheduled": 0, "no_admin": 0, "error": 0}
    for guild in bot.guilds:
        try:
            result = await dispatch_global_announcement(guild, content, sender_display)
            if result in stats:
                stats[result] += 1
            else:
                stats["error"] += 1
        except Exception as e:
            print(f"[ANNOUNCE ERROR] 無法處理伺服器 {guild.name}: {e}")
            stats["error"] += 1
    summary = (
        "全服公告已處理。\n"
        f"- 日誌頻道送達：{stats['log']}\n"
        f"- 線上管理員私訊：{stats['dm']}\n"
        f"- 等待管理員上線：{stats['scheduled']}\n"
        f"- 無可聯絡管理員：{stats['no_admin']}\n"
        f"- 發送失敗：{stats['error']}"
    )
    await interaction.followup.send(summary, ephemeral=True)

