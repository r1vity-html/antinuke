# 3. 老虎機遊戲 (/slot)
@bot.tree.command(name="slot", description="🎰 刺激老虎機！試試你的手氣（最低投注 10 幣）")
@app_commands.describe(bet="你要下注的金幣數量")
async def slot(interaction: discord.Interaction, bet: int):
    user_id = interaction.user.id
    
    if bet < 10:
        await interaction.response.send_message("❌ 最少必須下注 **10** 枚金幣！", ephemeral=True)
        return
        
    user_coins = get_user_coins(user_id)
    if user_coins < bet:
        await interaction.response.send_message(f"❌ 你的錢包不夠！目前僅有 **{user_coins}** 金幣，快去聊天賺錢吧！", ephemeral=True)
        return

    # 先扣除本金
    update_user_coins(user_id, -bet)
    
    # 老虎機圖案池
    emojis = ["🍒", "🍉", "🍇", "🍋", "🔔", "💎", "7️⃣"]
    
    # 滾動動畫效果（提升儀式感！）
    await interaction.response.send_message("🎰 **拉下搖桿，滾輪開始瘋狂轉動...**")
    await asyncio.sleep(0.8)
    
    # 隨機抽取三個結果
    r1 = random.choice(emojis)
    r2 = random.choice(emojis)
    r3 = random.choice(emojis)
    
    # 計算中獎邏輯
    if r1 == r2 == r3:
        # 三個一樣！大獎！
        if r1 == "7️⃣":
            reward = bet * 10  # 搖到 777 直接爆賺 10 倍
            msg = f"豪華大獎【777】！！！ 賺翻了！獲得 **{reward}** 金幣！"
        elif r1 == "💎":
            reward = bet * 7   # 鑽石 7 倍
            msg = f"大發了！璀璨鑽石連線！獲得 **{reward}** 金幣！"
        else:
            reward = bet * 4   # 普通三連 4 倍
            msg = f"恭喜三連線成功！獲得 **{reward}** 金幣！"
        
        update_user_coins(user_id, reward)
        color = discord.Color.red()
    elif r1 == r2 or r2 == r3 or r1 == r3:
        # 兩個一樣！小獎！
        reward = int(bet * 1.5)
        update_user_coins(user_id, reward)
        msg = f"小有收穫！雙喜臨門，獲得 **{reward}** 金幣！"
        color = discord.Color.green()
    else:
        # 全都不同，沒中
        reward = 0
        msg = "慘啦，全都沒對中！肥水落入外人田，謝謝老闆施捨！"
        color = discord.Color.dark_gray()

    # ─── ✨ 質感救星：大字體奢華星光流（100% 不歪、告別黑方塊） ───
    # 使用 ### 放大 Emoji，兩旁用高質感的星光與鑽石點綴，捨棄容易骨折的直槓
    slot_screen = (
        "\n"
        "=======================\n"
        f"|   ㅤ{r1}ㅤ•ㅤ{r2}ㅤ•ㅤ{r3}ㅤ   |\n"
        "=======================\n"
    )

    # 輸出最終精美成果 Embed
    embed = discord.Embed(title="🎰 兔兔黃金老虎機結果 🎰", color=color)
    embed.description = f"{slot_screen}\n\n**結果：** {msg}"
    embed.set_footer(text=f"玩家：{interaction.user.name} | 餘額：{get_user_coins(user_id)} 幣")
    
    await interaction.edit_original_response(content=None, embed=embed)

@bot.tree.command(name="work", description="💼 努力打工！一鍵開工並觀看隨機進度條（冷卻 3 分鐘）")
async def work(interaction: discord.Interaction):
    user_id = interaction.user.id
    current_time = time.time()
    
    # 1. 檢查冷卻時間
    if user_id in work_cooldowns and current_time < work_cooldowns[user_id]:
        remaining = int(work_cooldowns[user_id] - current_time)
        mins, secs = divmod(remaining, 60)
        time_str = f"{mins} 分 {secs} 秒" if mins > 0 else f"{secs} 秒"
        await interaction.response.send_message(f"❌ 體力還沒恢復！你太累了，還需要休息 `{time_str}` 才能再次上工！", ephemeral=True)
        return
        
    # 2. 隨機抽選今天的工作
    job_id = random.choice(list(JOB_POOL.keys()))
    job = JOB_POOL[job_id]
    
    # 3. 先發送「開工準備中」的初始畫面
    embed = discord.Embed(title=f"💼 兔兔人才人力銀行 ── 開工啦！", color=discord.Color.blue())
    embed.description = f"**當前工作：** `{job['name']}`\n> {job['desc']}\n\n**【工作進度】**\n`[░░░░░░░░░░]` 0%\n\n⏱️ *正在努力工作中，請稍候...*"
    embed.set_footer(text=f"員工：{interaction.user.name}")
    
    await interaction.response.send_message(embed=embed)
    
    # 4. 🎮 隨機進度條核心動畫動畫邏輯
    progress = 0
    while progress < 100:
        await asyncio.sleep(0.6) # 每 0.6 秒刷新一次狀態
        
        # 🎲 靈魂所在：每次隨機跳進度（可能一次衝 30%，也可能只跳 5%）
        jump = random.randint(10, 35) 
        progress += jump
        if progress > 100:
            progress = 100
            
        # 繪製進度條圖案（10格）
        num_blocks = progress // 10
        bar = "🟩" * num_blocks + "░" * (10 - num_blocks)
        
        # 更新 Embed 畫面
        embed.description = f"**當前工作：** `{job['name']}`\n> {job['desc']}\n\n**【工作進度】**\n`{bar}` {progress}%\n\n⏱️ *正在努力工作中，請稍候...*"
        await interaction.edit_original_response(embed=embed)
        
    # 5. 🏆 工作完成！計算發薪與暴擊獎勵
    await asyncio.sleep(0.5) # 稍微定格一下 100% 畫面
    
    # 隨機觸發工作表現「暴擊倍率」：大成功(1.5倍)、完美達成(2倍)、普通完成(1倍)
    luck = random.random()
    if luck < 0.1: # 10% 機率完美達成
        multiplier = 2.0
        bonus_msg = "🔥 **【完美達成】老闆看你骨骼清奇，發了雙倍薪水！**"
        final_color = discord.Color.red()
    elif luck < 0.3: # 20% 機率大成功
        multiplier = 1.5
        bonus_msg = "✨ **【表現優異】工作效率極高，獲得外快加薪！**"
        final_color = discord.Color.gold()
    else:
        multiplier = 1.0
        bonus_msg = "✅ 順利收工！辛苦了，這是你應得的血汗錢。"
        final_color = discord.Color.green()
        
    final_reward = int(job["base_reward"] * multiplier)
    
    # 寫入資料庫/發放金幣
    update_user_coins(user_id, final_reward)
    
    # 鎖定冷卻時間（設定 180 秒 = 3分鐘）
    work_cooldowns[user_id] = time.time() + 180
    
    # 6. 渲染最終發薪畫面
    embed.title = f"💰 工資發放處 ── 打工完成！"
    embed.color = final_color
    embed.description = (
        f"**完成工作：** `{job['name']}`\n\n"
        f"**工作評價：**\n> {bonus_msg}\n\n"
        f"💰 **獲得薪資：** **{final_reward}** 枚金幣！🪙"
    )
    embed.set_footer(text=f"員工：{interaction.user.name} | 錢包餘額：{get_user_coins(user_id)} 幣")
    
    await interaction.edit_original_response(embed=embed)
@system_group.command(name="remove-black", description="從全域黑名單移除機器人 (開發者)")
@app_commands.describe(bot_id="機器人 ID")
async def remove_black(interaction: discord.Interaction, bot_id: str):
