# ==========================================
# 4. 切換防文字洗頻開關（/toggle_spam）
# ==========================================
@server_group.command(name="toggle_spam", description="開啟或關閉聊天室防文字洗頻功能")
@app_commands.describe(action="選擇要開啟或關閉")
@app_commands.choices(action=[
    app_commands.Choice(name="開啟 (ON)", value="on"),
    app_commands.Choice(name="關閉 (OFF)", value="off")
])
async def toggle_spam(interaction: discord.Interaction, action: app_commands.Choice[str]):
    # 安全檢查：限制只有伺服器擁有者（Owner）可以使用
    if interaction.user.id != interaction.guild.owner_id:
        await interaction.response.send_message("❌ 只有伺服器擁有者（Owner）才能執行此指令！", ephemeral=True)
        return

    global spam_protection_enabled

    if action.value == "on":
        spam_protection_enabled = True
        await interaction.response.send_message("✅ 已**啟用**聊天室防文字洗頻功能（3秒發5則訊息自動禁言）。", ephemeral=True)
    else:
        spam_protection_enabled = False
        await interaction.response.send_message("🛑 已**關閉**聊天室防文字洗頻功能。", ephemeral=True)

@system_group.command(name="check-black", description="查詢某個 ID 是否在全域黑名單或白名單 (管理員)")
@app_commands.describe(entity_id="使用者或機器人 ID（純數字）")
async def check_black(interaction: discord.Interaction, entity_id: str):
    await interaction.response.defer(ephemeral=True)
    target_id = entity_id.strip()
    info_black = bot_blacklist.get(target_id)
    info_white = bot_whitelist.get(target_id)

    if not info_black and not info_white:
        embed = discord.Embed(title="查詢結果", color=discord.Color.green())
        embed.description = f"ID `{target_id}` 不在全域黑名單，也不在全域白名單。"
        embed.set_footer(text="防炸兔兔 v1.1.0")
        await interaction.followup.send(embed=embed, ephemeral=True)
        return

    embed = discord.Embed(title="查詢結果", color=discord.Color.orange())
    lines = []
    if info_black:
        lines.append("**黑名單**：")
        lines.append(f"- 名稱：`{info_black.get('name', target_id)}`")
        lines.append(f"- 原因：{info_black.get('reason', '無')}")
        ts = info_black.get("timestamp")
        if ts:
            lines.append(f"- 加入時間 (timestamp)：`{ts}`")
        guilds = info_black.get("guilds_detected", [])
        if guilds:
            lines.append(f"- 偵測伺服器 ID 列表：`{', '.join(str(x) for x in guilds)}`")
        lines.append("")

    if info_white:
        lines.append("**白名單**：")
        lines.append(f"- 名稱：`{info_white.get('name', target_id)}`")
        lines.append(f"- 原因：{info_white.get('reason', '無')}")
        tsw = info_white.get("timestamp")
        if tsw:
            lines.append(f"- 加入時間 (timestamp)：`{tsw}`")

    embed.description = "\n".join(lines)
    embed.set_footer(text="防炸兔兔 v1.1.0")
    await interaction.followup.send(embed=embed, ephemeral=True)

@server_group.command(name="snapshot_list", description="查看此伺服器目前擁有的所有快照版本")
async def snapshot_list(interaction: discord.Interaction):
    # ─── 修正：檢查是否擁有管理員權限 ───
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ 只有管理員才能執行此指令！", ephemeral=True)
        return

    await interaction.response.defer(ephemeral=True)
    guild = interaction.guild

    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        # 撈出該伺服器所有備份，最新排最前面
        cursor.execute("SELECT id, snapshot_json, updated_at FROM snapshots WHERE guild_id = %s ORDER BY updated_at DESC", (guild.id,))
        results = cursor.fetchall()
        cursor.close()
        conn.close()
    except Exception as e:
        await interaction.followup.send(f"❌ 讀取資料庫失敗: {e}")
        return

    if not results:
        await interaction.followup.send("❌ 目前沒有任何備份紀錄！請先使用 `/snapshot_create` 建立快照。")
        return

    embed = discord.Embed(
        title=f"📋 {guild.name} 歷史快照版本清單",
        description="目前資料庫中保留的版本如下（最多 5 個，最新排在最上面）：\n可以使用 `/snapshot_restore` 並輸入對應的 ID 進行還原。",
        color=discord.Color.blue()
    )

    for idx, row in enumerate(results, start=1):
        snap_id = row[0]
        raw_json = row[1]
        db_time = row[2]

        # 格式化時間
        if isinstance(db_time, (int, float)):
            formatted_time = datetime.datetime.fromtimestamp(db_time).strftime('%Y-%m-%d %H:%M:%S')
        else:
            formatted_time = db_time.strftime('%Y-%m-%d %H:%M:%S')

        # 計算該版本內有多少東西
        try:
            data = json.loads(raw_json)
            total_categories = len([c for c in data if c["name"] != "__NO_CATEGORY__"])
            total_channels = sum(len(cat["channels"]) for cat in data)
            structure_info = f"共 `{total_categories}` 分類 / `{total_channels}` 頻道"
        except Exception:
            structure_info = "未知結構"

        # 標記哪一個是最新的
        tag = " 🌟 [最新版本]" if idx == 1 else ""
        embed.add_field(
            name=f"編號 ID: {snap_id}{tag}",
            value=f"📅 備份時間: `{formatted_time}`\n📊 結構內容: {structure_info}",
            inline=False
        )

    await interaction.followup.send(embed=embed)

@bot.tree.command(name="leaderboard", description="查看金幣排行榜")
async def leaderboard(interaction: discord.Interaction):
    # 獲取排行榜資料
    top_users = get_leaderboard(10)
    
    if not top_users:
        await interaction.response.send_message("目前還沒有金幣紀錄喔！", ephemeral=True)
        return

    # 建立 Embed
    embed = discord.Embed(title="🏆 金幣排行榜 Top 10", color=discord.Color.gold())
    
    leaderboard_text = ""
    for i, user_data in enumerate(top_users, 1):
        # 嘗試從伺服器快取抓取使用者名稱
        member = interaction.guild.get_member(user_data['user_id'])
        name = member.display_name if member else f"ID: {user_data['user_id']}"
        
        # 顯示排名
        rank_icon = {1: "🥇", 2: "🥈", 3: "🥉"}.get(i, f"{i}.")
        leaderboard_text += f"{rank_icon} **{name}**: {user_data['coins']} 金幣\n"
    
    embed.description = leaderboard_text
    embed.set_footer(text="繼續解任務賺金幣吧！")
    
    await interaction.response.send_message(embed=embed)

@bot.tree.command(name="redpacket", description="🧧 灑金幣啦！發送一個拼手速隨機紅包到群組裡")
@app_commands.describe(total_coins="準備塞進紅包的總金幣量", pieces="總共要分給幾個人搶")
async def send_red_packet(interaction: discord.Interaction, total_coins: int, pieces: int):
    user_id = interaction.user.id
    
    if total_coins <= 0 or pieces <= 0:
        await interaction.response.send_message("❌ 金額和份數必須是大於 0 的正整數喔！", ephemeral=True)
        return
        
    if pieces > total_coins:
        await interaction.response.send_message(f"❌ 金幣太少不夠分！{pieces} 個紅包至少需要 {pieces} 枚金幣。", ephemeral=True)
        return

    # ─── 💾 核心邏輯：檢查發紅包的人錢夠不夠 ───
    conn = get_db_connection()
    if conn is None:
        await interaction.response.send_message("❌ 資料庫連線失敗！", ephemeral=True)
        return
    cursor = conn.cursor(dictionary=True)
    
    try:
        # 1. 撈出發紅包人的金幣餘額
        cursor.execute("SELECT coins FROM user_coins WHERE user_id = %s", (user_id,))
        user_data = cursor.fetchone()
        
        # 防呆：如果沒資料或錢不夠
        current_balance = user_data["coins"] if user_data else 0
        if current_balance < total_coins:
            await interaction.response.send_message(
                f"❌ 你的錢包空空如也！目前餘額：**{current_balance}** 金幣，不夠發 **{total_coins}** 金幣的紅包。", 
                ephemeral=True
            )
            return

        # 2. 扣除發紅包人的錢（呼叫你的 update_user_coins，傳入負數代表扣錢）
        update_user_coins(user_id, -total_coins)
        
        # 3. 將紅包資訊寫入新建立的紅包表
        cursor.execute(
            "INSERT INTO red_packets (creator_id, total_amount, total_pieces, remaining_amount, remaining_pieces, claimed_list) "
            "VALUES (%s, %s, %s, %s, %s, %s)",
            (user_id, total_coins, pieces, total_coins, pieces, json.dumps({}))
        )
        conn.commit()
        
        # 4. 拿到剛剛自動生成的紅包 ID
        packet_id = cursor.lastrowid
        
        # 5. 渲染精美的 Discord 紅包面板
        embed = discord.Embed(
            title="🧧 兔兔天降紅包雨！",
            description=f"{interaction.user.mention} 揮金如土，扔出了一個大紅包！\n群友們快來拼手速，看看誰是今天的運氣王！",
            color=discord.Color.red()
        )
        embed.add_field(name="💰 紅包總額", value=f"**{total_coins}** 金幣", inline=True)
        embed.add_field(name="👥 紅包份數", value=f"**{pieces}** 份", inline=True)
        embed.set_footer(text="提示：每個人只能搶一次，金額完全隨機喔！")
        
        # 發送帶有按鈕的紅包訊息
        await interaction.response.send_message(embed=embed, view=RedPacketView(packet_id))
        print(f"[紅包系統] {interaction.user.name} 成功發放了一個 ID 為 {packet_id} 的紅包。")
        
    except Exception as e:
        print(f"❌ [發紅包崩潰] 原因: {e}")
        await interaction.response.send_message("❌ 發行紅包失敗，系統已自動退回金幣。", ephemeral=True)
    finally:
        cursor.close()
        conn.close()


@bot.tree.command(name="rp_info", description="🧧 查看指定紅包的領取名單與詳情")
@app_commands.describe(packet_id="紅包的 ID (可以在資料庫或紅包紀錄中找到)")
async def check_red_packet(interaction: discord.Interaction, packet_id: int):
    conn = get_db_connection()
    if not conn:
        await interaction.response.send_message("❌ 資料庫連線失敗。", ephemeral=True)
        return
    
    cursor = conn.cursor(dictionary=True)
    cursor.execute("SELECT * FROM red_packets WHERE id = %s", (packet_id,))
    packet = cursor.fetchone()
    cursor.close()
    conn.close()
    
    if not packet:
        await interaction.response.send_message(f"❌ 找不到 ID 為 {packet_id} 的紅包紀錄。", ephemeral=True)
        return
        
    # 解析 JSON 領取清單
    claimed_data = json.loads(packet["claimed_list"]) if packet["claimed_list"] else {}
    
    # 建立精美的資訊面板
    embed = discord.Embed(title=f"🧧 紅包 #{packet_id} 領取詳情", color=discord.Color.gold())
    embed.add_field(name="💰 總金額", value=f"{packet['total_amount']} 金幣", inline=True)
    embed.add_field(name="👥 總份數", value=f"{packet['total_pieces']} 份", inline=True)
    embed.add_field(name="剩餘", value=f"{packet['remaining_pieces']} 份", inline=True)
    
    # 列出搶到的人
    if not claimed_data:
        embed.description = "目前還沒人搶過這個紅包喔！"
    else:
        desc = ""
        for uid, amount in claimed_data.items():
            # 嘗試抓取用戶名稱 (如果機器人剛好抓不到該用戶，就顯示 ID)
            user = interaction.guild.get_member(int(uid))
            name = user.display_name if user else f"用戶 {uid}"
            desc += f"👤 {name}: **{amount}** 金幣\n"
        embed.description = desc
        
    await interaction.response.send_message(embed=embed)
    
@bot.tree.command(name="give", description="🪙 慷慨解囊！直接轉帳金幣給伺服器裡的某個群友")
@app_commands.describe(target="想要給錢的對象 (@某人 或 選擇成員)", amount="要轉帳的金幣數量")
async def give_coins(interaction: discord.Interaction, target: discord.Member, amount: int):
    giver_id = interaction.user.id
    receiver_id = target.id
    
    # 1. 基礎防呆
    if target.bot:
        await interaction.response.send_message("❌ 兔兔和機器人夥伴們是不收賄賂的！請轉帳給一般人類。", ephemeral=True)
        return
        
    if giver_id == receiver_id:
        await interaction.response.send_message("❌ 左手交給右手有意思嗎？不能轉帳給自己啦！", ephemeral=True)
        return
        
    if amount <= 0:
        await interaction.response.send_message("❌ 轉帳金額必須是大於 0 的正整數喔！", ephemeral=True)
        return

    # 2. 透過 MySQL 檢查你的錢夠不夠，並執行轉帳
    conn = get_db_connection()
    if conn is None:
        await interaction.response.send_message("❌ 資料庫連線失敗，請稍後再試！", ephemeral=True)
        return
    cursor = conn.cursor(dictionary=True)
    
    try:
        # 撈出轉帳人（你）的餘額
        cursor.execute("SELECT coins FROM user_coins WHERE user_id = %s", (giver_id,))
        giver_data = cursor.fetchone()
        
        current_balance = giver_data["coins"] if giver_data else 0
        if current_balance < amount:
            await interaction.response.send_message(
                f"❌ 賸餘財產不足！你目前只有 **{current_balance}** 金幣，不夠支付 **{amount}** 金幣。", 
                ephemeral=True
            )
            return

        # 3. 雙向扣款與撥款
        # 扣除你的錢 (傳入負數)
        update_user_coins(giver_id, -amount)
        # 加上對方的錢 (傳入正數)
        update_user_coins(receiver_id, amount)
        
        # 4. 發送成功的精美 Embed 喜報
        embed = discord.Embed(
            title="💸 兔兔銀行轉帳成功！",
            description=f"{interaction.user.mention} 剛剛完成了一筆慷慨的轉帳！",
            color=discord.Color.green()
        )
        embed.add_field(name="👤 匯款人", value=interaction.user.mention, inline=True)
        embed.add_field(name="🎯 收款人", value=target.mention, inline=True)
        embed.add_field(name="💰 轉帳金額", value=f"**{amount}** 枚金幣 🪙", inline=False)
        embed.set_footer(text="誠信交易，概不退還。")
        
        # 公開在頻道廣播
        await interaction.response.send_message(embed=embed)
        print(f"[轉帳系統] {interaction.user.name} 成功轉帳 {amount} 金幣給 {target.name}。")
        
    except Exception as e:
        print(f"❌ [轉帳崩潰] 原因: {e}")
        await interaction.response.send_message("❌ 轉帳交易失敗，系統已鎖定資產。", ephemeral=True)
    finally:
        cursor.close()
        conn.close()

@server_group.command(name="snapshot_create", description="備份目前伺服器的頻道結構 (最多保留最新 5 個版本)")
async def snapshot_create(interaction: discord.Interaction):
    # ─── 修正：檢查是否擁有管理員權限 ───
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ 只有管理員才能執行此指令！", ephemeral=True)
        return

    await interaction.response.defer(ephemeral=True)
    guild = interaction.guild
    categories_data = []

    # A. 撈取無類別頻道
    no_category_channels = [ch for ch in guild.channels if ch.category is None and not isinstance(ch, discord.CategoryChannel)]
    if no_category_channels:
        orphan_info = {"name": "__NO_CATEGORY__", "position": 0, "channels": []}
        for channel in no_category_channels:
            orphan_info["channels"].append({
                "name": channel.name,
                "type": str(channel.type),
                "position": channel.position
            })
        categories_data.append(orphan_info)

    # B. 撈取正常分類頻道
    for category in guild.categories:
        category_info = {"name": category.name, "position": category.position, "channels": []}
        for channel in category.channels:
            category_info["channels"].append({
                "name": channel.name,
                "type": str(channel.type),
                "position": channel.position
            })
        categories_data.append(category_info)

    snapshot_json = json.dumps(categories_data, ensure_ascii=False)
    now_ts = time.time()

    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        
        # 1. 直接寫入新快照
        cursor.execute(
            "INSERT INTO snapshots (guild_id, snapshot_json, updated_at) VALUES (%s, %s, %s)",
            (guild.id, snapshot_json, now_ts)
        )
        
        # 2. 自動汰舊：刪除 5 名開外（比較舊）的快照
        cursor.execute(
            """
            DELETE FROM snapshots 
            WHERE guild_id = %s 
            AND id NOT IN (
                SELECT id FROM (
                    SELECT id FROM snapshots 
                    WHERE guild_id = %s 
                    ORDER BY updated_at DESC 
                    LIMIT 5
                ) as tmp
            )
            """,
            (guild.id, guild.id)
        )
        
        conn.commit()
        cursor.close()
        conn.close()
        await interaction.followup.send("✅ 伺服器結構快照已成功備份！系統已自動確保僅保留最新 5 個版本。")
    except Exception as e:
        await interaction.followup.send(f"❌ 備份失敗，資料庫錯誤: {e}")
# ==========================================
# 2. 還原快照指令（/snapshot_restore）
# ==========================================
# ==========================================
# 2. 【修正版】還原快照指令（/snapshot_restore）
#    增加了「避免重複建立頻道」的檢查與對比機制
# ==========================================
# ==========================================
# 2. 斜線指令本體（/snapshot_restore）
# ==========================================
# 注意：這裡加上了 app_commands.describe，讓使用者輸入時有提示
@server_group.command(name="snapshot_restore", description="從資料庫讀取快照並還原伺服器頻道結構 (自動避免重複)")
@app_commands.describe(snapshot_id="欲還原的快照編號 ID (留空則預設還原最新的一筆)")
async def snapshot_restore(interaction: discord.Interaction, snapshot_id: int = None):
    # ─── 修正：檢查是否擁有管理員權限 ───
    if not interaction.user.guild_permissions.administrator:
        await interaction.response.send_message("❌ 只有管理員才能執行此指令！", ephemeral=True)
        return

    await interaction.response.defer(ephemeral=True)
    guild = interaction.guild

    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        
        if snapshot_id:
            # 依據管理員指定的 ID 去抓，同時確認該 ID 是屬於該伺服器的（防止越權抓別人的）
            cursor.execute("SELECT snapshot_json, updated_at FROM snapshots WHERE id = %s AND guild_id = %s", (snapshot_id, guild.id))
        else:
            # 沒指定，預設抓最新的第一筆
            cursor.execute("SELECT snapshot_json, updated_at FROM snapshots WHERE guild_id = %s ORDER BY updated_at DESC LIMIT 1", (guild.id,))
            
        result = cursor.fetchone()
        cursor.close()
        conn.close()
    except Exception as e:
        await interaction.followup.send(f"❌ 讀取資料庫失敗: {e}")
        return

    if not result:
        if snapshot_id:
            await interaction.followup.send(f"❌ 找不到編號為 `{snapshot_id}` 的快照紀錄，或該快照不屬於此伺服器！請先使用 `/snapshot_list` 查詢。")
        else:
            await interaction.followup.send("❌ 找不到此伺服器的備份紀錄！請先執行 `/snapshot_create`。")
        return

    raw_json = result[0]
    db_time = result[1]

    try:
        if isinstance(db_time, (int, float)):
            formatted_time = datetime.datetime.fromtimestamp(db_time).strftime('%Y-%m-%d %H:%M:%S')
        else:
            formatted_time = db_time.strftime('%Y-%m-%d %H:%M:%S')
    except Exception:
        formatted_time = str(db_time)

    categories_data = json.loads(raw_json)
    total_categories = len([c for c in categories_data if c["name"] != "__NO_CATEGORY__"])
    total_channels = sum(len(cat["channels"]) for cat in categories_data)
    
    has_orphans = any(c["name"] == "__NO_CATEGORY__" for c in categories_data)
    added_info = f"包含 `{total_categories}` 個分類、共 `{total_channels}` 個頻道"
    if has_orphans:
        added_info += "（包含無分類的頂層頻道）"

    status_embed = discord.Embed(
        title="⚠️ 確定要還原伺服器結構嗎？",
        description=f"系統將比對資料庫快照 (ID: {snapshot_id if snapshot_id else '最新'}) 並補齊缺失的頻道與分類。",
        color=discord.Color.orange()
    )
    status_embed.add_field(name="📅 欲還原的版本時間", value=f"`{formatted_time}`", inline=False)
    status_embed.add_field(name="📊 快照結構內容", value=added_info, inline=False)
    status_embed.set_footer(text="提示：系統會自動跳過目前伺服器內已存在的同名同類型頻道。")

    # 這裡重複使用上一版幫你寫好的 RestoreConfirmView 即可 (邏輯完全相容)
    view = RestoreConfirmView(interaction, categories_data, formatted_time, added_info)
    await interaction.followup.send(embed=status_embed, view=view)
if __name__ == "__main__":
    if not TOKEN:
        print("錯誤: 找不到 DISCORD_TOKEN")
    else:
        print(f"啟動 防炸兔兔 {VERSION}...")
        bot.run(TOKEN)
