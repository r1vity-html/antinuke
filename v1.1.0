# ========== MySQL 連線 & SQL 存取函式 ==========

MYSQL_HOST = os.getenv("MYSQL_HOST", "c6f22e13-cd22-42c9-b4e9-6f5055d1aebd")
MYSQL_PORT = int(os.getenv("MYSQL_PORT", "3306"))
MYSQL_USER = os.getenv("MYSQL_USER", "")
MYSQL_PASSWORD = os.getenv("MYSQL_PASSWORD", "")
MYSQL_DB = os.getenv("MYSQL_DB", "")

# 1. 寫入或更新設定的函式
def update_bot_setting(key, value):
    global db, cursor
    try:
        # 將 boolean 轉換為 1 或 0 (MySQL 儲存 BOOLEAN 的方式)
        val_int = 1 if value else 0
        sql = """
        INSERT INTO bot_settings (key_name, value_bool) 
        VALUES (%s, %s) 
        ON DUPLICATE KEY UPDATE value_bool = %s
        """
        cursor.execute(sql, (key, val_int, val_int))
        db.commit()
    except Exception as e:
        print(f"❌ 更新設定失敗: {e}")

# 2. 從資料庫讀取設定的函式
def get_bot_setting(key):
    try:
        cursor.execute("SELECT value_bool FROM bot_settings WHERE key_name = %s", (key,))
        result = cursor.fetchone()
        # 如果有值則回傳，若查無資料則預設為 True (1)
        return bool(result[0]) if result else True
    except:
        return True

def get_db_connection():
    return mysql.connector.connect(
        host=MYSQL_HOST,
        port=MYSQL_PORT,
        user=MYSQL_USER,
        password=MYSQL_PASSWORD,
        database=MYSQL_DB,
        connection_timeout=10,
        autocommit=True
    )

def get_user_coins(user_id: int) -> int:
    """從資料庫讀取使用者的金幣，若無紀錄則自動建立並給予 100 初始金幣"""
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("SELECT coins FROM user_coins WHERE user_id = %s", (user_id,))
        result = cursor.fetchone()
        
        if result:
            coins = result[0]
        else:
            # 沒帳戶，直接開戶送 100
            cursor.execute("INSERT INTO user_coins (user_id, coins) VALUES (%s, 100)", (user_id,))
            conn.commit()
            coins = 100
            
        cursor.close()
        conn.close()
        return coins
    except Exception as e:
        print(f"[金幣系統] 讀取餘額失敗: {e}")
        return 0

def update_user_coins(user_id: int, amount: int):
    """增加或減少使用者的金幣 (amount 可為正數或負數)"""
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        # 使用 ON DUPLICATE KEY 確保帳戶一定存在
        cursor.execute("""
            INSERT INTO user_coins (user_id, coins) VALUES (%s, %s)
            ON DUPLICATE KEY UPDATE coins = coins + %s
        """, (user_id, 100 + amount if amount > 0 else 100, amount))
        conn.commit()
        cursor.close()
        conn.close()
    except Exception as e:
        print(f"[金幣系統] 更新餘額失敗: {e}")

def get_user_status(user_id: int):
    """從資料庫獲取使用者當前的任務與打工狀態 (防呆自動開戶)"""
    try:
        conn = get_db_connection()
        if conn is None:
            return {"task_id": None, "task_progress": 0, "task_completed": False, "task_time": 0.0, "work_cooldown": 0.0}
            
        # 💡 官方 mysql.connector 的 DictCursor 寫法是 dictionary=True
        cursor = conn.cursor(dictionary=True)
        
        # 1. 確保 user_coins 表裡一定有這個使用者
        # 💡 官方套件的預留字元是 %s
        cursor.execute("INSERT IGNORE INTO user_coins (user_id, coins) VALUES (%s, 100)", (user_id,))
        conn.commit() # 確保開戶寫入
        
        # 2. 撈出打工與任務欄位
        cursor.execute(
            "SELECT task_id, task_progress, task_completed, task_time, work_cooldown "
            "FROM user_coins WHERE user_id = %s", (user_id,)
        )
        result = cursor.fetchone()
        
        cursor.close()
        conn.close()
        
        if result:
            return result
        return {"task_id": None, "task_progress": 0, "task_completed": False, "task_time": 0.0, "work_cooldown": 0.0}
    except Exception as e:
        print(f"[系統] 讀取狀態失敗: {e}")
        return {"task_id": None, "task_progress": 0, "task_completed": False, "task_time": 0.0, "work_cooldown": 0.0}
    
def divide_red_packet(remaining_amount: int, remaining_pieces: int) -> int:
    if remaining_pieces == 1:
        return remaining_amount
    # 最多能抽到目前平均值的 2 倍
    max_amount = (remaining_amount // remaining_pieces) * 2
    if max_amount <= 1:
        max_amount = 2
    return random.randint(1, max_amount)

# ─── 🟥 搶紅包的按鈕界面 ───
class RedPacketView(discord.ui.View):
    def __init__(self, packet_id: int):
        super().__init__(timeout=None)  # 按鈕長期有效
        self.packet_id = packet_id

    @discord.ui.button(label="🧧 搶紅包！", style=discord.ButtonStyle.danger, custom_id="grab_red_packet_btn")
    async def grab_packet(self, interaction: discord.Interaction, button: discord.ui.Button):
        # 1. 直接從資料庫讀取設定，不再依賴 global 變數
        if not get_setting('redpacket_enabled', default=True):
            await interaction.response.send_message("⚠️ 紅包系統維護中，暫停領取！", ephemeral=True)
            return

        user_id = interaction.user.id
        conn = get_db_connection()
        if conn is None:
            await interaction.response.send_message("❌ 資料庫連線失敗，請稍後再試！", ephemeral=True)
            return
            
        cursor = conn.cursor(dictionary=True)
        
        try:
            # 核心安全鎖：鎖定這筆紅包資料避免同時搶奪
            cursor.execute("SELECT * FROM red_packets WHERE id = %s FOR UPDATE", (self.packet_id,))
            packet = cursor.fetchone()
            
            if not packet:
                await interaction.response.send_message("❌ 這個紅包已經在江湖中消失了！", ephemeral=True)
                return
                
            # 檢查剩餘份數
            if packet["remaining_pieces"] <= 0:
                await interaction.response.send_message("😭 手速太慢啦！紅包已經被搶光了！", ephemeral=True)
                button.disabled = True
                button.label = "🧧 已被搶光"
                await interaction.message.edit(view=self)
                return
                
            # 檢查是否搶過
            claimed = json.loads(packet["claimed_list"]) if packet["claimed_list"] else {}
            if str(user_id) in claimed:
                await interaction.response.send_message(f"❌ 你已經搶過這個紅包囉！你拿到了 **{claimed[str(user_id)]}** 金幣。", ephemeral=True)
                return
                
            # 計算金額並更新
            grabbed_amount = divide_red_packet(packet["remaining_amount"], packet["remaining_pieces"])
            claimed[str(user_id)] = grabbed_amount
            new_remaining_amount = packet["remaining_amount"] - grabbed_amount
            new_remaining_pieces = packet["remaining_pieces"] - 1
            
            cursor.execute(
                "UPDATE red_packets SET remaining_amount = %s, remaining_pieces = %s, claimed_list = %s WHERE id = %s",
                (new_remaining_amount, new_remaining_pieces, json.dumps(claimed), self.packet_id)
            )
            
            update_user_coins(user_id, grabbed_amount)
            conn.commit()
            
            # 回傳隱私訊息
            await interaction.response.send_message(f"🎉 恭喜你搶到了 **{grabbed_amount}** 枚金幣！🪙", ephemeral=True)
            
            # 2. 直接從資料庫檢查廣播開關
            if get_setting('redpacket_broadcast_enabled', default=True):
                creator = await interaction.client.fetch_user(packet["creator_id"])
                await interaction.channel.send(
                    f"🧧 【紅包喜報】{interaction.user.mention} 成功奪下 {creator.mention} 的紅包，斬獲 **{grabbed_amount}** 金幣！"
                    f" (剩餘 {new_remaining_pieces} 份)"
                )
            
            # 鎖定按鈕
            if new_remaining_pieces == 0:
                button.disabled = True
                button.label = "🧧 已被搶光"
                await interaction.message.edit(view=self)
                
        except Exception as e:
            print(f"❌ [紅包系統出錯] 原因: {e}")
            await interaction.response.send_message("❌ 搶紅包時系統發生未知錯誤！", ephemeral=True)
        finally:
            cursor.close()
            conn.close()

def update_user_status(user_id: int, **kwargs):
    """動態更新使用者的打工或任務狀態到 MySQL"""
    try:
        if not kwargs:
            return
        conn = get_db_connection()
        if conn is None:
            return
        cursor = conn.cursor()
        
        # 動態拼裝 SQL 語句
        set_clause = ", ".join([f"{key} = %s" for key in kwargs.keys()])
        sql = f"UPDATE user_coins SET {set_clause} WHERE user_id = %s"
        params = list(kwargs.values()) + [user_id]
        
        cursor.execute(sql, params)
        conn.commit() # 💡 攸關生死：官方套件必須 commit 才會真正存進去！
        cursor.close()
        conn.close()
    except Exception as e:
        print(f"[系統] 更新狀態失敗: {e}")

# ==========================================
# 💬 聊天賺金幣：請把這段邏輯塞進你原本的 on_message 事件中
# ==========================================
# (你可以直接把這段加在你的 on_message 函式最開頭，管理員免疫或機器人過濾完之後的位置)
# ==========================================
# 💬 聊天賺金幣：隨機機率掉落 + 自動通知版
# ==========================================
async def handle_chat_earn_coins(message: discord.Message):
    if message.author.bot or message.guild is None:
        return
        
    user_id = message.author.id
    content = message.content.strip().lower()
    
    # 讀取狀態
    status = get_user_status(user_id)
    # 如果狀態異常或沒任務，直接離開
    if not status or status.get("task_id") is None or status.get("task_completed"):
        return

    task_id = status["task_id"]
    current_progress = status["task_progress"]
    needed = TASK_POOL[task_id]["needed"]
    is_updated = False

    # 偵錯：看看任務是否真的有在跑
    print(f"[DEBUG] 處理任務 {task_id}, 當前進度: {current_progress}, 內容: '{content}'")

    # 統一邏輯：只要符合關鍵字，就觸發進度
    if task_id == 1 and any(w in content for w in ["早安", "午安", "晚安", "morning"]):
        current_progress = 1
        is_updated = True
    elif task_id == 2:
        current_progress += 1
        is_updated = True
    elif task_id == 3 and (message.stickers or "<:" in content or emoji.emoji_count(message.content) > 0):
        current_progress = 1
        is_updated = True
    # 🟢 任務 4：骰子任務
    elif task_id == 4 and "!dice" in content:
        # 即使內容包含 "!dice"，我們也要確保任務邏輯優先執行
        user_roll = random.randint(1, 6)
        bot_roll = random.randint(1, 6)
        
        if user_roll >= bot_roll:
            current_progress = 1
            is_updated = True # 注意：確保變數名稱統一為 is_updated (或你自己定義的那個)
            await message.channel.send(f"🎲 {message.author.mention} 擲出了 **{user_roll}** 點！兔兔擲出 **{bot_roll}** 點。\n🎉 贏了！任務進度達成！")
        else:
            await message.channel.send(f"🎲 {message.author.mention} 擲出了 **{user_roll}** 點... 兔兔擲出 **{bot_roll}** 點！\n❌ 輸啦！再試一次 `!dice` 吧！")
            # 這裡不要 return，讓後面邏輯判斷是否更新進度
            return 
            
    # 🟢 任務 5：點飲料
    elif task_id == 5 and "點一杯飲料" in content:
        drinks = ["珍珠奶茶🧋", "冰美式☕", "四季春青茶🍵", "多多綠茶🥤", "芒果冰沙🍧"]
        await message.channel.send(f"🥤 兔兔幫你送來了一杯 **{random.choice(drinks)}**！大口吸一口，任務進度達成！")
        current_progress = 1
        is_updated = True

    # 儲存結果
    if is_updated:
        is_done = current_progress >= needed
        update_user_status(user_id, task_progress=current_progress, task_completed=is_done)
        if is_done:
            update_user_coins(user_id, TASK_POOL[task_id]["reward"])
            await message.channel.send(f"🎉 恭喜完成任務！領取獎勵。")
            print(f"[系統] 玩家 {message.author.name} 完成任務 {task_id}")
def ensure_snapshots_table():
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute(
            """
            CREATE TABLE IF NOT EXISTS snapshots (
                guild_id BIGINT PRIMARY KEY,
                snapshot_json LONGTEXT NOT NULL,
                updated_at DOUBLE
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
            """
        )
        conn.commit()
        cursor.close()
        conn.close()
        print("[DB] 已確認 snapshots 資料表存在。")
    except Error as e:
        print(f"[DB ERROR] 建立/確認 snapshots 表失敗: {e}")


def load_blacklist():
    """從 MySQL 載入全域黑名單到記憶體 dict，結構維持與舊 JSON 一樣。"""
    data = {}
    try:
        conn = get_db_connection()
        cursor = conn.cursor(dictionary=True)
        cursor.execute("SELECT bot_id, name, reason, timestamp, guilds_detected FROM bot_blacklist")
        for row in cursor.fetchall():
            bot_id = str(row["bot_id"])
            guilds = []
            if row["guilds_detected"]:
                try:
                    guilds = json.loads(row["guilds_detected"])
                except Exception:
                    guilds = []
            data[bot_id] = {
                "name": row.get("name") or bot_id,
                "reason": row.get("reason") or "",
                "timestamp": float(row["timestamp"]) if row["timestamp"] is not None else 0,
                "guilds_detected": guilds,
            }
        cursor.close()
        conn.close()
        print(f"[DB] 從 MySQL 載入黑名單 {len(data)} 筆")
    except Error as e:
        print(f"[DB ERROR] 載入黑名單失敗: {e}")
    return data


def save_blacklist(data):
    """將記憶體中的黑名單 dict 寫回 MySQL。"""
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute("DELETE FROM bot_blacklist")
        insert_sql = """
            INSERT INTO bot_blacklist (bot_id, name, reason, timestamp, guilds_detected)
            VALUES (%s, %s, %s, %s, %s)
        """
        rows = 0
        for bot_id_str, info in data.items():
            try:
                bot_id = int(bot_id_str)
            except ValueError:
                continue
            name = info.get("name", bot_id_str)
            reason = info.get("reason", "")
            ts = info.get("timestamp", None)
            ts_val = float(ts) if ts is not None else None
            guilds = info.get("guilds_detected", [])
            guilds_str = json.dumps(guilds, ensure_ascii=False)
            cursor.execute(insert_sql, (bot_id, name, reason, ts_val, guilds_str))
            rows += 1
        conn.commit()
        cursor.close()
        conn.close()
        print(f"[DB] 已儲存黑名單 {rows} 筆到 MySQL")
    except Error as e:
        print(f"[DB ERROR] 儲存黑名單失敗: {e}")


